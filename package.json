{
  "name": "chess-helper",
  "version": "1.0.0",
  "description": "Always-on-top desktop chess analysis helper",
  "main": "main.js",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "build:web": "node scripts/build-web.js"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "stockfish": "19.0.1"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0"
  },
  "build": {
    "appId": "com.manikandanp24.chesshelper",
    "productName": "Chess Helper",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "node_modules/chess.js/**/*",
      "node_modules/stockfish/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}